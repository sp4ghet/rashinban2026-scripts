# Copy to .env in the main/shared checkout (gitignored) and fill in.
# All worktrees load this shared file at startup. Restart after edits.
# Never commit the real file. Public Maps browser keys go in cfg/rashinban.json.

# start.gg Personal Access Token (https://start.gg/admin/profile/developer)
STARTGG_TOKEN=

# GeoGuessr _ncfa cookie for the presenter's spectator connection
GEOGUESSR_NCFA=
