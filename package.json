{
  "name": "rashinban2026-scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Overlays and control stack for RASHINBAN 2026 (NodeCG)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "nodecg start",
    "preview": "npm run build && node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/preview.mjs",
    "dev": "npm run build && concurrently -n build,nodecg -c blue,green \"npm:watch\" \"npm:start\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tampermonkey/src/**/*.test.ts\" \"bundles/rashinban/src/banpick/tests/**/*.test.ts\" \"bundles/rashinban/src/startgg/tests/**/*.test.ts\" \"bundles/rashinban/src/sheet/tests/**/*.test.ts\" \"bundles/rashinban/src/presenter/tests/**/*.test.ts\" \"bundles/rashinban/src/config/tests/**/*.test.ts\"",
    "startgg:fetch": "node --env-file=.env scripts/startgg-fetch.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.2",
    "nodecg": "^2.8.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@nodecg/types": "^2.8.0",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
