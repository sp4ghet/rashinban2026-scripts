        "file": "presenter-control.html",
        "width": 3,
        "headerColor": "#335f9b"
      },
      {
        "name": "banpick-control",
        "workspace": "broadcast",
        "title": "Ban & Pick",
        "file": "banpick-control.html",
        "width": 4,
        "headerColor": "#1565c0"
      },
      {
        "name": "startgg-control",
        "workspace": "config",
        "title": "start.gg",
        "file": "startgg-control.html",
        "width": 4,
        "headerColor": "#37474f"
      },
      {
        "name": "sheet-control",
        "workspace": "config",
        "title": "Google Sheets",
        "file": "sheet-control.html",
        "width": 3,
        "headerColor": "#256549"
      },
      {
        "name": "player-cards-control",
        "workspace": "broadcast",
        "title": "Player Cards",
        "file": "player-cards-control.html",
        "width": 4,
        "headerColor": "#6a1b9a"
      }
    ]
