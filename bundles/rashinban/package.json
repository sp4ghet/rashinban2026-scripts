{
  "name": "rashinban",
  "version": "0.1.0",
  "private": true,
  "nodecg": {
    "compatibleRange": "^2.0.0",
    "assetCategories": [
      {
        "name": "music",
        "title": "Presenter music",
        "allowedTypes": [
          "wav",
          "mp3",
          "ogg",
          "m4a"
        ]
      },
      {
        "name": "effects",
        "title": "Presenter cue sounds",
        "allowedTypes": [
          "wav",
          "mp3",
          "ogg",
          "m4a"
        ]
      },
      {
        "name": "video",
        "title": "Presenter celebrations",
        "allowedTypes": [
          "webm",
          "mp4"
        ]
      }
    ],
    "graphics": [
      {
        "file": "presenter-audio.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "presenter.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "banpick-stream.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "banpick-led.html",
        "width": 1920,
        "height": 1080
      },
      {
        "file": "banpick-player.html",
        "width": 1280,
        "height": 800
      },
      {
        "file": "player-cards.html",
        "width": 1920,
        "height": 1080
      }
    ],
    "dashboardPanels": [
      {
        "name": "current-match",
        "workspace": "broadcast",
        "title": "Current Match",
        "file": "current-match.html",
        "width": 6,
        "headerColor": "#256549"
      },
      {
        "name": "presenter-control",
        "workspace": "config",
